# ==============================================================================
# Aqua Pets Aquarium Backend - Hostinger Production Environment Template (.env)
# ==============================================================================

PORT=5000
NODE_ENV=production
CLIENT_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aqua_pets_aquarium?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_production_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway (Live Credentials)
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Shiprocket Courier API
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD="your_shiprocket_password_here"
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret_here

# Meta WhatsApp Cloud API
WHATSAPP_API_TOKEN=your_meta_whatsapp_cloud_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_SHOP_OWNER_NUMBER=916238392582

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Transactional Emails (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM_NAME="AquaPets Aquarium"
EMAIL_FROM_ADDRESS=your_email@gmail.com
